# Cổng lắng nghe của Ingestion API
PORT=3456

# Địa chỉ Email người nhận báo cáo định kỳ tuần (Repo Owner)
OWNER_EMAIL=krystalnguyen594@gmail.com

# Cấu hình gửi mail SMTP (Nếu để trống, hệ thống sẽ chạy ở chế độ Simulation Mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Đường dẫn database SQLite (mặc định server/data/eval.db)
DB_PATH=server/data/eval.db
